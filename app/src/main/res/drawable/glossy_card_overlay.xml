<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base black -->
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Top glossy highlight -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="120dp">
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#25FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Left side highlight for 3D effect -->
    <item android:left="0dp" android:right="280dp" android:top="20dp" android:bottom="20dp">
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Subtle border -->
    <item>
        <shape>
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>