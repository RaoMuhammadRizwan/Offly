<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="6dp"
        android:right="4dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Main circle with gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#2A2A2A"
                android:centerColor="#1A1A1A"
                android:endColor="#0A0A0A"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#333333" />
        </shape>
    </item>
</layer-list>