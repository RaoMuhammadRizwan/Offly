<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:startColor="#1A1A1A"
                android:endColor="#000000"
                android:angle="270" />

            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />

            <corners android:radius="12dp" />

        </shape>
    </item>
</selector>
