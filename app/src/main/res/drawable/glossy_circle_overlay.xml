<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glossy black -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Glossy highlight on top -->
    <item android:top="20dp" android:left="40dp" android:right="120dp" android:bottom="200dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.3"
                android:centerY="0.3"
                android:gradientRadius="0.8"
                android:startColor="#40FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Subtle bottom reflection -->
    <item android:top="200dp" android:left="60dp" android:right="60dp" android:bottom="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#15FFFFFF" />
        </shape>
    </item>
</layer-list>