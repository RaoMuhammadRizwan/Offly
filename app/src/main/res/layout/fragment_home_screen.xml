<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_dark_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Cards Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Today's Usage Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_today_usage"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:foreground="?android:attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_content_cards"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:id="@+id/header_today_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_time" />

                        <TextView
                            android:id="@+id/tv_today_usage_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's Usage"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Usage Value -->
                    <TextView
                        android:id="@+id/tv_today_usage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 00m"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_centerInParent="true" />

                    <!-- Overlay -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/overlay_today_usage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#AA000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/overlay_label_bg"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Lock icon"
                                android:src="@drawable/ic_lock" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to unlock"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.8"
                                android:textAlignment="center"
                                android:text="Track your daily usage"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Top Apps Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_top_apps"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:foreground="?android:attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_content_cards"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:id="@+id/header_top_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_apps" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top 3 Apps"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Apps List -->
                    <LinearLayout
                        android:id="@+id/layout_top_apps_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_below="@id/header_top_apps"
                        android:layout_marginTop="4dp"
                        android:dividerPadding="8dp"
                        android:showDividers="middle">

                        <include
                            android:id="@+id/rowApp1"
                            layout="@layout/item_top_app" />

                        <include
                            android:id="@+id/rowApp2"
                            layout="@layout/item_top_app" />

                        <include
                            android:id="@+id/rowApp3"
                            layout="@layout/item_top_app" />
                    </LinearLayout>

                    <!-- Overlay -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/overlay_top_apps"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#AA000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/overlay_label_bg"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Lock icon"
                                android:src="@drawable/ic_lock" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to unlock"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.8"
                                android:textAlignment="center"
                                android:text="View your top apps"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>