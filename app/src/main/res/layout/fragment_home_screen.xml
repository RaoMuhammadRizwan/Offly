<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_dark_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <!-- First Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Today's Usage Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_today_usage"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_content_cards"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_today_usage_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Usage"
                        android:textSize="18sp"
                        android:textColor="#F8F4F4"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tv_today_usage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 00m"
                        android:textSize="36sp"
                        android:textColor="#F8F4F4"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_permission_required"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permission required to view usage"
                        android:textSize="14sp"
                        android:textColor="#FF6B6B"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Top 3 Apps Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_top_apps"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top 3 Apps"
                        android:textSize="18sp"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 Instagram"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45m"
                            android:textSize="14sp"
                            android:textColor="#666" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 YouTube"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="35m"
                            android:textSize="14sp"
                            android:textColor="#666" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 TikTok"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30m"
                            android:textSize="14sp"
                            android:textColor="#666" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Second Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Quick Block Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_quick_block"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Block"
                        android:textSize="18sp"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="15m"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#f0f0f0"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="1h"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#f0f0f0"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Rest of Day"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#f0f0f0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Active Blocks Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_active_blocks"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Blocks"
                        android:textSize="18sp"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#f0f0f0"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instagram: 2h/day"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TikTok: Blocked"
                            android:textSize="14sp"
                            android:textColor="#666" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Third Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Weekly Chart Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_weekly_chart"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Chart"
                        android:textSize="18sp"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_gravity="center">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="30dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="25dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="35dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="50dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="40dp"
                            android:background="#888"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:background="#888" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Focus Mode Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_focus_mode"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Mode"
                        android:textSize="18sp"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Start 30 min"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#f0f0f0"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Start 1 hour"
                        android:textSize="16sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#f0f0f0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>